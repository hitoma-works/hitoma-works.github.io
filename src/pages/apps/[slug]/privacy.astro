---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { appUrl, formatDate, getAppDoc, getApps, supportUrl, type App } from '../../../lib/apps';

export const getStaticPaths = (async () => {
  const apps = await getApps();
  return apps.map((app) => ({ params: { slug: app.id }, props: { app } }));
}) satisfies GetStaticPaths;

const { app } = Astro.props as { app: App };
const doc = await getAppDoc(app.id, 'privacy');
const { Content } = await render(doc);
---

<Base title={`プライバシーポリシー | ${app.data.name}`} description={doc.data.description}>
  <article class="prose">
    <p class="eyebrow">PRIVACY POLICY</p>
    <h1>プライバシーポリシー</h1>
    <p class="lead">{app.data.name}</p>
    <p class="meta">
      制定日：{formatDate(app.data.privacyEstablished)}<br />
      最終改定日：{formatDate(app.data.privacyUpdated)}
    </p>

    <Content />

    <ul class="link-list back">
      <li><a href={appUrl(app.id)}>{app.data.name}のページへ</a></li>
      <li><a href={supportUrl(app.id)}>サポート・よくある質問</a></li>
    </ul>
  </article>
</Base>

<style>
  h1 {
    font-size: 1.75rem;
    margin-bottom: 8px;
  }
  .lead {
    margin-bottom: 8px;
  }
  .meta {
    color: var(--text-mute);
    font-size: 0.875rem;
    margin-bottom: 32px;
  }
  .back {
    margin-top: 48px;
  }
</style>
