---
import type { App } from '../lib/apps';

interface Props {
  app: App;
}

// 紹介動画。YouTube のプライバシー強化モード（youtube-nocookie.com）で埋め込む。
// 再生するまで YouTube は Cookie を置かない。privacy.astro にも書いてある（2026-10-26 Ko）。
const { app } = Astro.props;
const video = app.data.video!;
const id = new URL(video.url).searchParams.get('v');
---

<div class="video">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}?rel=0`}
    title={video.alt}
    loading="lazy"
    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen></iframe>
</div>

<style>
  .video {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(17, 24, 39, 0.12);
    background: #000;
  }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
